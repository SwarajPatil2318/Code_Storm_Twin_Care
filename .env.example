# Optional live meal-photo analysis. No credentials are included.
# tools/run.py reads the private root .env; existing shell variables take precedence.
# Direct service-module launches require these variables to be exported first.
MEAL_ANALYSIS_PROVIDER=gemini
GEMINI_API_KEY=
# Enter a Gemini model ID available to your account that supports images and JSON schema.
TWINCARE_MEAL_VISION_MODEL=

# Optional alternative: MEAL_ANALYSIS_PROVIDER=openai
OPENAI_API_KEY=
# Use MEAL_ANALYSIS_PROVIDER=disabled for manual meal entry only.

# Alternatively select MEAL_ANALYSIS_PROVIDER=http for a compatible private
# structured vision service. HTTPS is required except for loopback development.
TWINCARE_MEAL_ANALYSIS_ENDPOINT=
TWINCARE_MEAL_ANALYSIS_TOKEN=
